rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (('email' in request.auth.token) && request.auth.token.email == 'mahmoudomran324@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin')
      );
    }

    function isValidId(id) {
      return id is string && id.matches('^[a-zA-Z0-9_\\-]+$') && id.size() > 0 && id.size() <= 128;
    }

    function isValidUserProfile(data) {
      return data.uid is string &&
             data.email is string &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
             (!('photoUrl' in data) || data.photoUrl is string) &&
             data.role in ['super_admin', 'moderator', 'user'] &&
             data.isBanned is bool &&
             (!('followersCount' in data) || data.followersCount is number) &&
             (!('followingCount' in data) || data.followingCount is number) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidVideo(data) {
      return data.authorId is string &&
             data.authorName is string && data.authorName.size() > 0 &&
             (!('authorPhotoUrl' in data) || data.authorPhotoUrl is string) &&
             data.videoUrl is string && data.videoUrl.size() > 0 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 500)) &&
             data.category in ['community', 'foryou', 'friends', 'live'] &&
             (!('viewsCount' in data) || data.viewsCount is number) &&
             (!('likesCount' in data) || data.likesCount is number) &&
             (!('commentsCount' in data) || data.commentsCount is number) &&
             (!('sharesCount' in data) || data.sharesCount is number) &&
             data.isBlocked is bool &&
             (!('adminWatermark' in data) || data.adminWatermark is string) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidComment(data) {
      return data.videoId is string &&
             data.authorId is string &&
             data.authorName is string && data.authorName.size() > 0 &&
             (!('authorPhotoUrl' in data) || data.authorPhotoUrl is string) &&
             data.content is string && data.content.size() > 0 && data.content.size() <= 500 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    function isValidLiveStream(data) {
      return data.hostId is string &&
             data.hostName is string && data.hostName.size() > 0 &&
             (!('hostAvatar' in data) || data.hostAvatar is string) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 120 &&
             (!('viewerCount' in data) || data.viewerCount is number) &&
             data.isActive is bool &&
             data.startedAt is timestamp && data.startedAt <= request.time &&
             (!('updatedAt' in data) || (data.updatedAt is timestamp && data.updatedAt <= request.time));
    }

    function isValidModerator(data) {
      return data.uid is string &&
             data.email is string &&
             data.assignedBy is string &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // --- Users Collection ---
    match /users/{userId} {
      allow get: if true;
      allow list: if isSignedIn();

      allow create: if isSignedIn() &&
                       request.auth.uid == userId &&
                       isValidId(userId) &&
                       isValidUserProfile(request.resource.data) &&
                       (request.resource.data.role == 'super_admin' ? (('email' in request.auth.token) && request.auth.token.email == 'mahmoudomran324@gmail.com') : true);

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.isBanned == resource.data.isBanned &&
         request.resource.data.email == resource.data.email &&
         request.resource.data.createdAt == resource.data.createdAt &&
         isValidUserProfile(request.resource.data))
      );

      allow delete: if isSuperAdmin();
    }

    // --- Videos Collection ---
    match /videos/{videoId} {
      allow get: if isValidId(videoId) && (!resource.data.isBlocked || isSuperAdmin() || (isSignedIn() && resource.data.authorId == request.auth.uid));
      allow list: if true;

      allow create: if isSignedIn() &&
                       isValidId(videoId) &&
                       request.resource.data.authorId == request.auth.uid &&
                       request.resource.data.isBlocked == false &&
                       isValidVideo(request.resource.data);

      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (request.resource.data.authorId == resource.data.authorId &&
         request.resource.data.createdAt == resource.data.createdAt &&
         isValidVideo(request.resource.data) &&
         (resource.data.authorId == request.auth.uid ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'commentsCount', 'sharesCount', 'updatedAt'])))
      );

      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }

    // --- Comments Collection ---
    match /comments/{commentId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
                       isValidId(commentId) &&
                       request.resource.data.authorId == request.auth.uid &&
                       isValidComment(request.resource.data);

      allow delete: if isSignedIn() && (resource.data.authorId == request.auth.uid || isSuperAdmin());
    }

    // --- Live Streams Collection ---
    match /live_streams/{streamId} {
      allow get, list: if true;

      allow create: if isSignedIn() &&
                       isValidId(streamId) &&
                       request.resource.data.hostId == request.auth.uid &&
                       isValidLiveStream(request.resource.data);

      allow update: if isSignedIn() && (
        resource.data.hostId == request.auth.uid ||
        isSuperAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewerCount', 'updatedAt'])
      );

      allow delete: if isSignedIn() && (resource.data.hostId == request.auth.uid || isSuperAdmin());
    }

    // --- Moderators Collection ---
    match /moderators/{modId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSuperAdmin() && isValidId(modId) && (request.resource == null || isValidModerator(request.resource.data));
    }
  }
}
